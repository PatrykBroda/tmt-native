# Copy as .env next to main.js (or set in your shell before running `electron .`)

# Backend API — change to http://localhost:5000 for local dev
API_BASE=https://admin.agencytmt.com

# obs-websocket v5 settings (Tools → WebSocket Server Settings in OBS)
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# OBS profile name that has obs-multi-rtmp installed
# (Help → Profile → <name>  — default is "Untitled")
OBS_PROFILE=Untitled
