# Add these to your existing Replit .env (Secrets panel)

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be different from your session secret
DESKTOP_JWT_SECRET=replace_with_long_random_string

# Displayed to the Electron app for update checks
APP_VERSION=1.0.0

# Your site's own RTMP ingest URL — included in stream-config alongside Chaturbate etc.
SITE_RTMP_URL=rtmp://your-site-ingest-url/live
